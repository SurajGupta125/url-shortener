<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Email Verification</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css">

    <link rel="stylesheet" href="/css/output.css">

</head>


<body class="m-0 p-0 min-h-screen flex flex-col">

    <% if (user) { %>

        <% if (user) { %>
            <div class="mt-5 ml-5 w-43.5 rounded border border-green-600 bg-green-50 p-2 font-semibold text-green-700">
                <i class="fa-solid fa-circle-check mr-1"></i>
                You are logged in
            </div>
            <% } else { %>

                <div class="text-red-600 bg-red-100 px-4 py-2 rounded">
                    <i class="fa-solid fa-circle-xmark mr-2"></i>
                    You are not logged in
                </div>
                <% } %>

            <% } %>

                <main class="flex-1 flex items-center justify-center p-4  flex-col">

                    <!-- <a href="/"
                    class="absolute top-5 left-10 bg-blue-500 text-white border border-blue-700 py-1 px-2 rounded text-2xl">Home</a> -->

                    <h1 class="text-3xl font-semibold mt-4">
                        Verify Your Email
                    </h1>


                    <!-- Success Message -->

                    <% if(success && success.length> 0){ %>

                        <div id="successMessage"
                            class="w-full max-w-md mt-4 bg-green-100 border border-green-300 text-green-700 rounded-lg p-3 transition-opacity duration-500">

                            <%= success[0] %>

                        </div>

                        <% } %>

                            <!-- Error Message -->

                            <% if(errors && errors.length> 0){ %>

                                <div id="errorMessage"
                                    class="w-full max-w-md mt-4 bg-red-100 border border-red-300 text-red-700 rounded-lg p-3 transition-opacity duration-500">

                                    <%= errors[0] %>

                                </div>

                                <% } %>

                                    <!-- User Email -->

                                    <div
                                        class="w-full max-w-md shadow-[0_0_20px_rgba(0,0,0,0.2)] bg-white rounded p-4 mt-5">


                                        <h2 class="text-lg font-semibold">

                                            Email:

                                            <span class="font-normal text-gray-700">

                                                <%= user.email %>

                                            </span>


                                        </h2>

                                        <p class="mt-4 text-gray-700">

                                            Your email is not verified yet.

                                            Click below to receive a 6-digit verification code.

                                        </p>

                                        <!-- Send OTP Button -->

                                        <form action="/send-verification-code" method="POST"
                                            class="flex justify-end mt-4">

                                            <button type="submit"
                                                class="bg-gray-700 cursor-pointer hover:bg-gray-800   text-white py-2 px-3 rounded">

                                                <i class="fa-solid fa-paper-plane"></i>

                                                Send Verification Code

                                            </button>

                                        </form>
                                    </div>


                                    <!-- Verify OTP -->


                                    <div
                                        class="bg-white rounded p-4 mt-5 w-full max-w-md shadow-[0_0_20px_rgba(0,0,0,0.2)]">

                                        <form action="/verify-email" method="POST">

                                            <div
                                                class="bg-white rounded p-4 mt-5 w-full max-w-md shadow-[0_0_20px_rgba(0,0,0,0.2)]">

                                                <input type="text" name="verificationCode" maxlength="6" minlength="6"
                                                    pattern="[0-9]{6}" required
                                                    placeholder="Enter 6-Digit Verification Code"
                                                    class="outline-none py-3 w-full border-b-2 border-gray-500">

                                                <div class="flex justify-start mt-4">

                                                    <button type="submit"
                                                        class="bg-blue-600 hover:bg-blue-700 text-white py-1.5  px-3 rounded cursor-pointer">

                                                        <i class="fa-solid fa-circle-check"></i>
                                                        Verify Now

                                                    </button>

                                                    <a href="/profile"
                                                        class="bg-blue-600 hover:bg-blue-700 ml-2 text-white py-1.5 max-[323px]:px-2 px-3 rounded cursor-pointer">

                                                        <i class="fa-solid fa-user"></i>
                                                        Profile

                                                    </a>

                                                </div>

                                            </div>

                                        </form>

                                    </div>

                                    </div>
                </main>

</body>
<script>

    function autoHide(id) {

        const message = document.getElementById(id);

        if (message) {

            setTimeout(() => {

                message.classList.add("opacity-0");

                setTimeout(() => {

                    message.remove();

                }, 500);

            }, 3000);

        }

    }

    autoHide("successMessage");
    autoHide("errorMessage");

</script>

</html>