<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Change Password</title>
    <link rel="stylesheet" href="footer.css">
    <link rel="stylesheet" href="navbar.css">
    <link rel="stylesheet" href="/css/output.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="m-0 p-0 min-h-screen flex flex-col">

    <%- include("navbar") %>
        <% if (user) { %>
            <div class="mt-5 ml-5 w-43.5 rounded border border-green-600 bg-green-50 p-2 font-semibold text-green-700">
                <i class="fa-solid fa-circle-check mr-1"></i>
                You are logged in
            </div>
            <% } else { %>

                <div class="text-red-600 bg-red-100 px-4 py-2 rounded">
                    <i class="fa-solid fa-circle-xmark mr-2"></i>
                    You are not logged in
                </div>
                <% } %>
                    <main class="flex-1 w-full flex justify-center items-center px-4 py-8">

                        <div class="w-full max-w-md min-[768px]:max-w-lg p-5 sm:p-6
            shadow-[0_0_20px_rgba(0,0,0,0.3)] rounded-lg">

                            <!-- Title & Blue Bar -->
                            <h2 class="text-2xl font-bold text-gray-900 tracking-tight">Change Your Password</h2>
                            <div class="w-12 h-1 bg-[#2563eb] rounded-sm mt-2 mb-7"></div>

                            <!-- Password Form -->
                            <form action="/change-password" method="POST" class="space-y-6">

                                <!-- Current Password Input -->
                                <div class="relative flex items-center border-b-2 border-gray-800 pb-2">
                                    <i class="fa-solid fa-lock absolute left-1 text-gray-800 text-sm"></i>
                                    <input type="password" id="currentPassword" name="currentPassword"
                                        placeholder="Enter your current password"
                                        class="w-full px-8 text-sm text-gray-800 bg-transparent placeholder-gray-700 focus:outline-none"
                                        required>
                                    <i class="fa-regular fa-eye absolute right-1 text-gray-800 text-sm cursor-pointer hover:text-gray-600"
                                        onclick="togglePassword('currentPassword', this)"></i>
                                </div>

                                <!-- New Password Input -->
                                <div class="relative flex items-center border-b-2 border-gray-800 pb-2">
                                    <i class="fa-solid fa-lock absolute left-1 text-gray-800 text-sm"></i>
                                    <input type="password" id="newPassword" name="newPassword"
                                        placeholder="Enter your new password"
                                        class="w-full px-8 text-sm text-gray-800 bg-transparent placeholder-gray-600 focus:outline-none"
                                        required>
                                    <i class="fa-regular fa-eye absolute right-1 text-gray-800 text-sm cursor-pointer hover:text-gray-600"
                                        onclick="togglePassword('newPassword', this)"></i>
                                </div>

                                <!-- Password Requirements Box -->
                                <div class="bg-[#f3f5f9] p-4 rounded-md my-6">
                                    <p class="text-xs font-semibold text-gray-800 mb-2.5">Password must:</p>
                                    <ul class="list-disc pl-5 space-y-1.5 text-xs text-gray-800">
                                        <li>Be at least 8 characters long</li>
                                        <li>Contain a number</li>
                                        <li>Include uppercase and lowercase letters</li>
                                    </ul>
                                </div>

                                <!-- Confirm Password Input -->
                                <div class="relative flex items-center border-b-2 border-gray-800 pb-2">
                                    <i class="fa-solid fa-lock absolute left-1 text-gray-800 text-sm"></i>
                                    <input type="password" id="confirmPassword" name="confirmPassword"
                                        placeholder="Confirm your new password"
                                        class="w-full px-8 text-sm text-gray-800 bg-transparent placeholder-gray-700 focus:outline-none"
                                        required>
                                    <i class="fa-regular fa-eye absolute right-1 text-gray-800 text-sm cursor-pointer hover:text-gray-600"
                                        onclick="togglePassword('confirmPassword', this)"></i>
                                </div>

                                <% if (errors && errors.length> 0) { %>

                                    <% errors.forEach(error=> { %>

                                        <p class="text-red-700 mt-2 p-2 bg-red-300 border-l-4 rounded ">
                                            <%= error %>
                                        </p>

                                        <% }) %>

                                            <% } %>

                                                <!-- Submit Button -->
                                                <button type="submit"
                                                    class="w-full bg-[#2563eb] hover:bg-[#1d4ed8] text-white text-sm font-medium py-3 rounded transition-colors duration-200 mt-2">
                                                    Change Password
                                                </button>

                            </form>
                        </div>
                    </main>
                    <%- include("footer") %>
                        <script src="/password.js"></script>
</body>

</html>