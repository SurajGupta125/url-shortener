<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>URL Shortener</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/navbar.css">
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/footer.css">
    <link rel="stylesheet" href="/register.css">
</head>

<body>

    <%- include("navbar") %>

        <% if (user) { %>

            <div class="login-status success">
                <i class="fa-solid fa-circle-check"></i>
                <h5>You are logged in</h5>
            </div>

            <% } else { %>

                <div class="login-status danger">
                    <span>⚠️</span>
                    <h5>You are not logged in</h5>
                </div>

                <% } %>


                    <main class="main-content">

                        <div class="container">

                            <h1>🔗 URL Shortener</h1>

                            <form action="/" method="POST">

                                <div class="form-group">
                                    <label>Enter URL</label>

                                    <input type="url" name="url" placeholder="https://example.com" required>
                                </div>


                                <div class="form-group">
                                    <label>Custom Short Code (Optional)</label>

                                    <input type="text" name="shortCode" placeholder="my-link">
                                </div>


                                <% if (errors && errors.length> 0) { %>

                                    <% errors.forEach(error=> { %>

                                        <p class="error-message">
                                            <%= error %>
                                        </p>

                                        <% }) %>

                                            <% } %>


                                                <button class="short-btn" type="submit">
                                                    Shorten URL
                                                </button>

                            </form>


                            <h2>Shortened URLs</h2>


                            <% if (links.length===0) { %>

                                <p>No shortened URLs found.</p>

                                <% } else { %>

                                    <ul>

                                        <% links.forEach(link=> { %>

                                            <li class="store-url">

                                                <a href="/<%= link.shortCode %>" target="_blank">
                                                    http://<%= host %>/<%= link.shortCode %>
                                                </a>


                                                <small>
                                                    <%= link.url %>
                                                </small>


                                                <div class="action-btns">

                                                    <!-- Copy -->
                                                    <button type="button" class="copy-btn"
                                                        onclick="copyCode('http://<%= host %>/<%= link.shortCode %>')">
                                                        <i class="fa-regular fa-copy"></i>
                                                    </button>


                                                    <!-- Edit -->
                                                    <a href="/edit/<%= link._id %>" class="edit-btn">
                                                        <i class="fa-solid fa-pen-to-square"></i>
                                                    </a>


                                                    <!-- Delete -->
                                                    <form action="/delete/<%= link._id %>" method="POST">
                                                        <button type="submit" class="delete-btn">
                                                            <i class="fa-solid fa-trash-can"></i>
                                                        </button>
                                                    </form>

                                                </div>

                                            </li>

                                            <% }) %>

                                    </ul>

                                    <% } %>

                        </div>

                    </main>


                    <%- include("footer") %>
</body>

<script>
    const copyCode = (url) => {
        navigator.clipboard.writeText(url);
    };
</script>

</html>