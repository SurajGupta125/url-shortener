<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit Profile</title>

    <link rel="stylesheet" href="/navbar.css">
    <link rel="stylesheet" href="/footer.css">
    <link rel="stylesheet" href="/css/output.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css">
</head>

<body class="m-0 p-0 min-h-screen flex flex-col">
    <%- include("navbar") %>
        <% if (user) { %>
            <div
                class="mt-5 ml-5 w-43.5 rounded border border-green-600 bg-green-50 p-2 font-semibold text-green-700">
                <i class="fa-solid fa-circle-check mr-1"></i>
                You are logged in
            </div>
            <% } else { %>

                <div class="text-red-600 bg-red-100 px-4 py-2 rounded">
                    <i class="fa-solid fa-circle-xmark mr-2"></i>
                    You are not logged in
                </div>
                <% } %>
                    <!-- Main Content -->
                    <main class="flex-1 flex items-center justify-center p-4">

                        <div class="w-full max-w-md p-5 shadow-[0_0_20px_rgba(0,0,0,0.2)]">

                            <h2 class="text-xl font-semibold text-gray-700 pb-1">
                                <span class="border-b-4 border-blue-700">
                                    Edit
                                </span>
                                Your Profile
                            </h2>


                            <form action="/edit-profile" method="post" class="mt-4">

                                <!-- Name -->
                                <div class="relative flex items-center">

                                    <i class="fa-solid fa-user absolute left-0 text-gray-500"></i>

                                    <input type="text" name="profile_name" value="<%= user.name %>"
                                        class="w-full text-base py-2 pl-6 pr-3 outline-none border-0 border-b-2 border-gray-400 bg-white focus:border-blue-700 transition-colors">

                                </div>


                                <!-- Email -->
                                <div class="relative flex items-center mt-3">

                                    <i class="fa-solid fa-envelope-circle-check absolute left-0 text-gray-500"></i>

                                    <input type="text" name="profile_email" value="<%= user.email %>"
                                        class="w-full text-base py-2 pl-6 pr-3 outline-none border-0 border-b-2 border-gray-400 bg-white focus:border-blue-700 transition-colors">

                                </div>

                                <% if (errors && errors.length> 0) { %>

                                    <% errors.forEach(error=> { %>

                                        <p class="text-red-700 mt-2 p-2 bg-red-300 border-l-4 rounded ">
                                            <%= error %>
                                        </p>

                                        <% }) %>

                                            <% } %>


                                                <!-- Button -->
                                                <button type="submit"
                                                    class="w-full mt-5 p-2 rounded text-white bg-blue-700 hover:bg-blue-800 cursor-pointer transition">
                                                    Save Changes
                                                </button>

                            </form>

                        </div>

                    </main>


                    <!-- Footer -->
                    <%- include("footer") %>

</body>

</html>