<!DOCTYPE html>
<html lang="en">

<head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Document</title>
        <link rel="stylesheet" href="/css/output.css">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="h-screen flex items-center justify-center">
        <main class="w-md bg-blue-50 p-4 rounded-2xl shadow-[0_0_20px_rgba(0,0,0,0.3)]">
                <div class="w-full flex justify-center items-center flex-col">
                        <img src="/images/forgot-password-icon.png" alt="forget-password">
                        <h1 class="text-2xl text-gray-900 font-semibold">Forget Password</h1>
                        <p class="text-gray-600 text-sm">Enter your registered email address</p>
                </div>
                <div class="mt-2 p-4">
                        <form action="forget-password" method="post" class="flex flex-col gap-y-4">
                                <div>
                                        <label for="email" class="text-gray-900">Email Address</label>
                                        <div
                                                class=" flex w-full border text-gray-800 rounded p-2 mt-1 items-center border-gray-400">
                                                <i class="fa-solid fa-envelope-circle-check"
                                                        style="color: rgb(53, 58, 53);"></i>
                                                <input type="email" class="outline-none pl-3 text-lg text-gray-800"
                                                        placeholder="Enter your email" required name="registerEmail"
                                                        id="email">
                                        </div>
                                </div>

                                <% if (errors && errors.length> 0) { %>

                                        <% errors.forEach(error=> { %>

                                                <p class="text-red-700 mt-2 p-2 bg-red-300 border-l-4 rounded ">
                                                        <%= error %>
                                                </p>

                                                <% }) %>

                                                        <% } %>


                                                                <button type="submit"
                                                                        class="w-full rounded-xl border-2 border-blue-700 p-3 bg-blue-600 cursor-pointer text-sm font-semibold text-white shadow-md transition-all duration-300 hover:bg-blue-700 hover:shadow-lg active:scale-[0.98]">
                                                                        <i class="fa-solid fa-paper-plane mr-2"></i>
                                                                        Send OTP
                                                                </button>

                                                                <a href="/login"
                                                                        class="text-center text-sm font-medium text-gray-600 transition hover:text-blue-600">

                                                                        <i class="fa-solid fa-arrow-left mr-1"></i>

                                                                        Back to login

                                                                </a>

                                                                <div
                                                                        class="flex items-center justify-center text-sm text-gray-500">
                                                                        <i class="fa-solid fa-lock text-blue-950"></i>
                                                                        <p class="pl-2">We will never share your email
                                                                                with anyone.</p>
                                                                </div>
                        </form>
                </div>
        </main>
</body>

</html>