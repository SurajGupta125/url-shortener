<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/output.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="h-screen flex items-center justify-center">
    <main class="w-md bg-blue-50 p-4 rounded-2xl shadow-[0_0_20px_rgba(0,0,0,0.3)]">
        <div class="w-full flex justify-center items-center flex-col">
            <img src="/images/reset-password-icon.png" alt="forget-password">
            <h1 class="text-2xl text-gray-900 font-semibold">Reset Password</h1>
            <p class="text-gray-600 text-sm">Enter your new password below</p>
        </div>
        <div class="mt-2 p-4">
            <form action="reset-password" method="post" class="flex flex-col gap-y-4">
                <label for="">New Password</label>
                <div class="relative flex items-center border rounded border-gray-800 p-2">
                    <i class="fa-solid fa-lock absolute left-3 text-gray-400 text-sm"></i>
                    <input type="password" name="newpassword" id="newPassword" placeholder="New Password"
                        class="w-full px-6 text-lg text-gray-600 bg-transparent placeholder-gray-400 focus:outline-none"
                        required>
                    <i
                        class="fa-regular fa-eye absolute right-3 text-gray-400 text-sm cursor-pointer hover:text-gray-600" onclick="togglePassword('newPassword', this)"></i>
                </div>

                <label for="">Confrim New Password</label>
                <div class="relative flex items-center border rounded border-gray-700 p-2">
                    <i class="fa-solid fa-lock absolute left-3 text-gray-400 text-sm"></i>
                    <input type="password" name="confpassword" id="confirmPassword" placeholder="Confirm your new password"
                        class="w-full px-6 text-lg text-gray-600 bg-transparent placeholder-gray-400 focus:outline-none"
                        required>
                    <i
                        class="fa-regular fa-eye absolute right-3 text-gray-400 text-sm cursor-pointer hover:text-gray-600" onclick="togglePassword('confirmPassword', this)"></i>
                </div>

                <% if (errors && errors.length> 0) { %>

                    <% errors.forEach(error=> { %>

                        <p class="text-red-700 mt-2 p-2 bg-red-300 border-l-4 rounded ">
                            <%= error %>
                        </p>

                        <% }) %>

                            <% } %>


                                <button type="submit"
                                    class="w-full rounded-xl border-2 border-blue-700 p-3 bg-blue-600 cursor-pointer text-sm font-semibold text-white shadow-md transition-all duration-300 hover:bg-blue-700 hover:shadow-lg active:scale-[0.98]">
                                    <i class="fa-solid fa-paper-plane mr-2"></i>
                                    Reset Password
                                </button>

                                <a href="/login"
                                    class="text-center text-sm font-medium text-gray-600 transition hover:text-blue-600">
                                    <i class="fa-solid fa-arrow-left mr-1"></i>Back to login
                                </a>
            </form>
        </div>
    </main>
    <script src="/password.js"></script>
</body>

</html>