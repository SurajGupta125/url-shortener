<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
    <link rel="stylesheet" href="/css/output.css">
    <link rel="stylesheet" href="/navbar.css">
    <link rel="stylesheet" href="/footer.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css">
</head>

<body class="m-0 p-0 min-h-screen flex flex-col">
    <%- include("navbar") %>
        <% if (user) { %>
            <div class="mt-5 ml-5 w-43.5 rounded border border-green-600 bg-green-50 p-2 font-semibold text-green-700">
                <i class="fa-solid fa-circle-check mr-1"></i>
                You are logged in
            </div>
            <% } else { %>

                <div class="text-red-600 bg-red-100 px-4 py-2 rounded">
                    <i class="fa-solid fa-circle-xmark mr-2"></i>
                    You are not logged in
                </div>
                <% } %>
                    <main
                        class="flex-1 w-full flex justify-center items-center px-4 py-8 min-[768px]:max-w-3xl min-[768px]:mx-auto flex-col">
                        <div class="w-full max-w-3xl min-[768px]:max-w-2xl p-4 mt-0 shadow-[0_0_20px_rgba(0,0,0,0.4)]">
                            <div class="flex flex-col justify-center items-center">
                                <p class="text-3xl text-blue-800 font-semibold">Your Profile</p>
                                <p>Manage your account and profile information</p>
                            </div>
                            <div class="mt-4 p-2">
                                <div class="bg-blue-600 p-3.5 rounded-t-2xl">

                                    <div class="flex flex-col sm:flex-row sm:items-center gap-5">

                                        <!-- Upload Form -->
                                        <div class="w-full sm:w-auto">
                                            <form action="/profile" method="post" enctype="multipart/form-data"
                                                class="m-0 w-full flex flex-col gap-3">
                                                <img src="<%= user.profileImage || '/images/profile.png' %>"
                                                    alt="Profile"
                                                    class="h-24 w-24 max-[426px]:m-auto flex items-center justify-center rounded-full text-4xl text-white font-semibold border" />

                                                <input type="file" name="profileImage"
                                                    accept="image/png, image/jpeg, image/jpg" required
                                                    class="border-blue-800 text-[12px] rounded-xl p-2 cursor-pointer bg-white">

                                                <button type="submit"
                                                    class="border-blue-800 text-[12px] rounded-xl font-bold hover:border-blue-700 hover:bg-blue-500 hover:text-white p-2 bg-white text-blue-600">
                                                    Upload Image
                                                </button>
                                            </form>
                                        </div>
                                        <div class=" overflow-x-auto">
                                            <table class="w-full text-left text-white">
                                                <tbody>
                                                    <tr class="border-b flex flex-wrap border-white/20">
                                                        <th class="py-3 pr-6 font-semibold whitespace-nowrap">
                                                            <i class="fa-solid fa-user mr-2"></i>
                                                            Name
                                                        </th>
                                                        <td class="py-3 break-all">
                                                            <%= user.name %>
                                                        </td>
                                                    </tr>

                                                    <tr class="border-b flex flex-wrap border-white/20">
                                                        <th class="py-3 pr-6 font-semibold whitespace-nowrap">
                                                            <i class="fa-solid fa-envelope mr-2"></i>
                                                            Email
                                                        </th>
                                                        <td class="py-3 break-all">
                                                            <%= user.email %>
                                                        </td>
                                                    </tr>

                                                    <tr class="border-b flex flex-wrap border-white/20">
                                                        <th class="py-3 pr-6 font-semibold whitespace-nowrap">
                                                            <i class="fa-solid fa-calendar mr-2"></i>
                                                            Member Since
                                                        </th>
                                                        <td class="py-3 whitespace-nowrap">
                                                            <%= new Date(user.createdAt).toLocaleDateString("en-GB") %>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>

                                <div class="w-full max-w-md mt-4 m-auto grid grid-cols-1 sm:grid-cols-3 gap-3">
                                    <div
                                        class="border rounded-lg p-3 flex flex-col justify-center items-center text-center">
                                        <h2 class="text-xl font-bold">
                                            <%= linksCreated %>
                                        </h2>
                                        <p class="text-sm text-gray-600">
                                            Links Created
                                        </p>
                                    </div>
                                    <div
                                        class="border rounded-lg p-3 flex flex-col justify-center items-center text-center">
                                        <h2 class="text-xl font-bold">
                                            <%= totalClicks %>
                                        </h2>
                                        <p class="text-sm text-gray-600">
                                            Total Clicks
                                        </p>
                                    </div>
                                    <div
                                        class="border rounded-lg p-3 flex flex-col justify-center items-center text-center">
                                        <h2 class="text-xl font-bold">
                                            <%= lastActive %>
                                        </h2>
                                        <p class="text-sm text-gray-600">
                                            Last Active
                                        </p>
                                    </div>
                                </div>
                                <div class="mt-8">
                                    <div class="flex justify-between flex-wrap gap-y-5 items-center">
                                        <div class="flex flex-wrap items-center gap-2 gap-y-2">
                                            <h3 class="font-semibold text-gray-800 text-2xl">
                                                Email Verification
                                            </h3>
                                            <% if (user.isEmailVerified) { %>
                                                <div
                                                    class="flex items-center gap-2 bg-green-300 py-1 px-1.25 rounded text-[10px] text-green-800">
                                                    <i class="fa-solid fa-circle-check"></i>
                                                    <span class="font-semibold">
                                                        Email Verified
                                                    </span>
                                                </div>
                                                <% } else { %>
                                                    <div
                                                        class="flex items-center gap-2 bg-red-300 py-1 px-1.25 rounded text-[10px] text-red-800">
                                                        <i class="fa-solid fa-circle-xmark"></i>
                                                        <span class="font-semibold">
                                                            Not Verified
                                                        </span>
                                                    </div>
                                                    <% } %>
                                        </div>
                                        <% if (!user.isEmailVerified) { %>

                                            <a href="/email-verification"
                                                class="bg-blue-800 py-1.5 px-2 rounded text-white">
                                                <i class="fa-solid fa-shield-halved mr-2"></i>
                                                Verify Now
                                            </a>
                                            <% } %>
                                    </div>
                                    <div class="mt-8 flex flex-wrap gap-2 justify-between items-center">
                                        <a href="/edit-profile"
                                            class="w-full sm:w-[30%] bg-blue-800 text-center hover:bg-blue-900 font-semibold rounded py-2 text-white text-sm md:text-base">
                                            <i class="fa-solid fa-user-pen mr-2"></i>
                                            Edit Profile
                                        </a>
                                        <a href="/change-password"
                                            class="w-full sm:w-[30%] bg-blue-800 text-center hover:bg-blue-900 font-semibold rounded py-2 text-white  text-sm md:text-base">
                                            <i class="fa-solid fa-lock mr-2"></i>
                                            Change Password
                                        </a>
                                        <a href="/logout"
                                            class="w-full sm:w-[30%] bg-blue-800 text-center hover:bg-blue-900 font-semibold rounded py-2 text-white  text-sm md:text-base">
                                            <i class="fa-solid fa-right-from-bracket mr-2"></i>
                                            Logout
                                        </a>
                                    </div>
                                </div>
                            </div>
                    </main>
                    <%- include("footer") %>

                        <!-- Preview Image  -->
</body>

</html>